# Local development defaults (committed, no secrets). Loaded when ENVIRONMENT is unset or
# "development". Put personal overrides and real credentials in `.env` (git-ignored).
# Staging/production have no file: set every variable on the platform.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Infrastructure from `pnpm infra:up` (docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Development-only signing key. Production must provide its own (>= 32 chars).
JWT_SECRET=development-only-secret-never-use-in-production-0123

# Web app (links in emails) and allowed browser origins (web dev server, Expo web)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# console = log it | smtp = send it (Mailpit: SMTP_HOST=localhost, SMTP_PORT=1025) | outbox = tests
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.com
# console = log it | expo = Expo Push API (EXPO_ACCESS_TOKEN if enhanced security) | outbox = tests
PUSH_BACKEND=console

# Unauthenticated Prometheus endpoint at /metrics; keep it off the public internet
METRICS_ENABLED=true
# Error reporting stays off until SENTRY_DSN is set
SENTRY_TRACES_SAMPLE_RATE=0
