# Local development values (committed, no secrets). Personal overrides go in `.env.local`.
# EAS builds get these from the EAS environment of the profile (`eas env:create`), see eas.json.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_IOS_STORE_ID=
APP_ID=com.example.mobile
