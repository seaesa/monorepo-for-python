{
  "name": "monorepo-for-python",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=api",
    "dev:web": "turbo dev --filter=api --filter=web",
    "dev:mobile": "turbo dev --filter=api --filter=mobile",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write . --log-level warn && pnpm --filter api format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "codegen": "pnpm --filter @workspace/api-client codegen",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "theme": "pnpm --filter @workspace/theme generate && pnpm --filter @workspace/theme check",
    "format:check": "prettier --check . && pnpm --filter api format:check",
    "knip": "knip",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "husky": "^9.1.7",
    "knip": "^6.44.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
