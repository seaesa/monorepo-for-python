{
  "name": "monorepo-for-python",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=api",
    "dev:web": "turbo dev --filter=api --filter=web",
    "dev:mobile": "turbo dev --filter=api --filter=mobile",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "codegen": "pnpm --filter @workspace/api-client codegen",
    "theme": "pnpm --filter @workspace/theme generate && pnpm --filter @workspace/theme check",
    "infra:up": "docker compose up -d postgres redis mailpit",
    "infra:down": "docker compose down",
    "format": "oxfmt && pnpm --filter api format",
    "format:check": "oxfmt --check && pnpm --filter api format:check",
    "lint": "oxlint && pnpm --filter api lint",
    "lint:fix": "oxlint --fix",
    "lint:deps": "depcruise packages/*/src packages/*/scripts && depcruise apps/web/src --ts-config apps/web/tsconfig.json && depcruise apps/mobile/src --ts-config apps/mobile/tsconfig.json",
    "lint:spell": "cspell --no-progress --gitignore --dot .",
    "lint:dup": "jscpd",
    "lint:monorepo": "sherif",
    "knip": "node --env-file=apps/mobile/.env.development node_modules/knip/bin/knip.js",
    "check": "pnpm format:check && pnpm lint && pnpm lint:deps && pnpm lint:spell && pnpm lint:dup && pnpm lint:monorepo && pnpm knip && pnpm typecheck && pnpm test",
    "prepare": "lefthook install",
    "audit": "pnpm audit --prod --audit-level high && pnpm --filter api run audit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "cspell": "^10.5.1",
    "dependency-cruiser": "^18.7.2",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jscpd": "^5.4.3",
    "knip": "^6.45.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "sherif": "^1.13.0",
    "squawk-cli": "^2.73.0",
    "turbo": "^2.11.11",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
